# 01-scripts.rsc - GENERATED by router/tools/build-scripts.mjs
# Do not edit by hand: change router/src/*.rsc and rebuild.
# Installs the Don Robert Cafe Wi-Fi scripts. Safe to re-import (replaces them).

/system script remove [find where name="drc-epoch"]
/system script add name=drc-epoch policy=read,write,test dont-require-permissions=no comment="Don Robert Cafe Wi-Fi" source=":local st \"\"\r\
    \n:do { :set st [:tostr [/system ntp client get status]] } on-error={}\r\
    \n:if (\$st != \"synchronized\") do={ :return 0 }\r\
    \n:local strip do={\r\
    \n  :if ([:pick \$1 0 1] = \"0\") do={ :return [:tonum [:pick \$1 1 [:len \$1]]] }\r\
    \n  :return [:tonum \$1]\r\
    \n}\r\
    \n:local d [:tostr [/system clock get date]]\r\
    \n:local t [:tostr [/system clock get time]]\r\
    \n:local y 0\r\
    \n:local m 0\r\
    \n:local dd 0\r\
    \n:if ([:pick \$d 4 5] = \"-\") do={\r\
    \n  :set y [:tonum [:pick \$d 0 4]]\r\
    \n  :set m [\$strip [:pick \$d 5 7]]\r\
    \n  :set dd [\$strip [:pick \$d 8 10]]\r\
    \n} else={\r\
    \n  :local months {\"jan\";\"feb\";\"mar\";\"apr\";\"may\";\"jun\";\"jul\";\"aug\";\"sep\";\"oct\";\"nov\";\"dec\"}\r\
    \n  :set m ([:find \$months [:pick \$d 0 3]] + 1)\r\
    \n  :set dd [\$strip [:pick \$d 4 6]]\r\
    \n  :set y [:tonum [:pick \$d 7 11]]\r\
    \n}\r\
    \n:if (\$y < 2025) do={ :return 0 }\r\
    \n:local hh [\$strip [:pick \$t 0 2]]\r\
    \n:local mi [\$strip [:pick \$t 3 5]]\r\
    \n:local ss [\$strip [:pick \$t 6 8]]\r\
    \n:if (\$m <= 2) do={ :set y (\$y - 1) }\r\
    \n:local era (\$y / 400)\r\
    \n:local yoe (\$y - (\$era * 400))\r\
    \n:local mp 0\r\
    \n:if (\$m > 2) do={ :set mp (\$m - 3) } else={ :set mp (\$m + 9) }\r\
    \n:local doy ((((153 * \$mp) + 2) / 5) + (\$dd - 1))\r\
    \n:local doe ((((\$yoe * 365) + (\$yoe / 4)) - (\$yoe / 100)) + \$doy)\r\
    \n:local days (((\$era * 146097) + \$doe) - 719468)\r\
    \n:return (((\$days * 86400) + (\$hh * 3600)) + ((\$mi * 60) + \$ss))"

/system script remove [find where name="drc-backup"]
/system script add name=drc-backup policy=ftp,read,write,policy,test,sensitive dont-require-permissions=no comment="Don Robert Cafe Wi-Fi" source=":local epoch [:parse [/system script get drc-epoch source]]\r\
    \n:local now [\$epoch]\r\
    \n:local wd \"nodate\"\r\
    \n:if (\$now > 0) do={\r\
    \n  :local days ((\$now / 86400) + 4)\r\
    \n  :local names {\"sun\";\"mon\";\"tue\";\"wed\";\"thu\";\"fri\";\"sat\"}\r\
    \n  :set wd (\$names->(\$days - ((\$days / 7) * 7)))\r\
    \n}\r\
    \n:local nm (\"drc-auto-\" . \$wd)\r\
    \n/file remove [find where name=(\$nm . \".backup\")]\r\
    \n/file remove [find where name=(\$nm . \".rsc\")]\r\
    \n/system backup save name=\$nm dont-encrypt=yes\r\
    \n/export file=\$nm\r\
    \n:delay 3s\r\
    \n:local stamp ([:tostr [/system clock get date]] . \" \" . [:tostr [/system clock get time]])\r\
    \n/system scheduler set [find where name=\"drc-backup\"] comment=(\"drc last backup \" . \$stamp . \" \" . \$nm)\r\
    \n:log info (\"drc-backup: saved \" . \$nm)"

/system script remove [find where name="drc-closing"]
/system script add name=drc-closing policy=read,write,test dont-require-permissions=no comment="Don Robert Cafe Wi-Fi" source=":local re \"^[SG][A-HJKMNP-Z2-9]{5}\\\$\"\r\
    \n:local st \"\"\r\
    \n:do { :set st [:tostr [/system ntp client get status]] } on-error={}\r\
    \n:if (\$st != \"synchronized\") do={ :log warning \"drc-closing: clock not synced yet, skipped\"; :return \"\" }\r\
    \n:local n [:len [/ip hotspot user find where name~\$re]]\r\
    \n/ip hotspot active remove [find where user~\$re]\r\
    \n/ip hotspot cookie remove [find where user~\$re]\r\
    \n/ip hotspot user remove [find where name~\$re]\r\
    \n:log info (\"drc-closing: removed \" . \$n . \" codes\")"

/system script remove [find where name="drc-cloud-sync"]
/system script add name=drc-cloud-sync policy=read,write,test dont-require-permissions=no comment="Don Robert Cafe Wi-Fi" source=":local re \"^[SG][A-HJKMNP-Z2-9]{5}\\\$\"\r\
    \n:local nl \"\\n\"\r\
    \n:global drcSyncBusy\r\
    \n:if ([:typeof \$drcSyncBusy] != \"num\") do={ :set drcSyncBusy 0 }\r\
    \n:local myJob [:pick [/system script job find where script=\"drc-cloud-sync\"] ([:len [/system script job find where script=\"drc-cloud-sync\"]] - 1)]\r\
    \n:if ([:len [/system script job find where script=\"drc-cloud-sync\"]] > 1) do={\r\
    \n  :set drcSyncBusy (\$drcSyncBusy + 1)\r\
    \n  :if (\$drcSyncBusy < 3) do={ :error \"drc-cloud-sync: previous run still busy\" }\r\
    \n  :foreach j in=[/system script job find where script=\"drc-cloud-sync\"] do={\r\
    \n    :if (\$j != \$myJob) do={ /system script job remove \$j }\r\
    \n  }\r\
    \n  :log warning \"drc-cloud-sync: an earlier check-in was stuck and has been stopped\"\r\
    \n}\r\
    \n:set drcSyncBusy 0\r\
    \n:local cfgId [/system script find where name=\"drc-cloud-config\"]\r\
    \n:if ([:len \$cfgId] = 0) do={ :error \"drc-cloud-sync: script drc-cloud-config is missing\" }\r\
    \n:local cfgS [:tostr [/system script get \$cfgId source]]\r\
    \n:local bar [:find \$cfgS \"|\"]\r\
    \n:if ([:typeof \$bar] = \"nil\") do={ :error \"drc-cloud-sync: drc-cloud-config must be URL|KEY\" }\r\
    \n:local url [:pick \$cfgS 0 \$bar]\r\
    \n:local key [:pick \$cfgS (\$bar + 1) [:len \$cfgS]]\r\
    \n:local okKey \"\"\r\
    \n:for i from=0 to=([:len \$key] - 1) do={\r\
    \n  :local ch [:pick \$key \$i (\$i + 1)]\r\
    \n  :if ((\$ch != \"\\r\") && (\$ch != \"\\n\") && (\$ch != \" \")) do={ :set okKey (\$okKey . \$ch) }\r\
    \n}\r\
    \n:local fld do={\r\
    \n  :local rest \$1\r\
    \n  :local i 0\r\
    \n  :while (\$i < \$2) do={\r\
    \n    :local b [:find \$rest \"|\"]\r\
    \n    :if ([:typeof \$b] = \"nil\") do={ :return \"\" }\r\
    \n    :set rest [:pick \$rest (\$b + 1) [:len \$rest]]\r\
    \n    :set i (\$i + 1)\r\
    \n  }\r\
    \n  :local b [:find \$rest \"|\"]\r\
    \n  :if ([:typeof \$b] = \"nil\") do={ :return \$rest }\r\
    \n  :return [:pick \$rest 0 \$b]\r\
    \n}\r\
    \n:local bc \"\"\r\
    \n:do { :set bc [/system scheduler get [find where name=\"drc-backup\"] comment] } on-error={}\r\
    \n:local gd \"\"\r\
    \n:do { :set gd [/ip hotspot user profile get [find where name=\"group-3h\"] shared-users] } on-error={}\r\
    \n:local rl \"\"\r\
    \n:do { :set rl [/ip hotspot user profile get [find where name=\"solo-3h\"] rate-limit] } on-error={}\r\
    \n:local it \"\"\r\
    \n:do { :set it [/ip hotspot get [:pick [/ip hotspot find] 0] idle-timeout] } on-error={}\r\
    \n:local ntp \"\"\r\
    \n:do { :set ntp [:tostr [/system ntp client get status]] } on-error={}\r\
    \n:local body (\"v1\" . \$nl . \"i|\" . [/system identity get name] . \"|\" . [/system resource get board-name] . \"|\" . [/system resource get version] . \"|\" . \$bc . \"|\" . \$gd . \"|\" . \$rl . \"|\" . \$it . \"|\" . [:tostr [/system resource get uptime]] . \"|\" . \$ntp . \$nl)\r\
    \n:foreach id in=[/ip hotspot user find where name~\$re] do={\r\
    \n  :local c [:tostr [/ip hotspot user get \$id comment]]\r\
    \n  :if ([:typeof [:find \$c \"start=\"]] = \"nil\") do={ :set c \"\" }\r\
    \n  :local d \"0\"\r\
    \n  :if ([/ip hotspot user get \$id disabled]) do={ :set d \"1\" }\r\
    \n  :set body (\$body . \"u|\" . [/ip hotspot user get \$id name] . \"|\" . \$d . \"|\" . \$c . \$nl)\r\
    \n}\r\
    \n:foreach id in=[/ip hotspot active find where user~\$re] do={\r\
    \n  :local m [:tostr [/ip hotspot active get \$id mac-address]]\r\
    \n  :local tl \"\"\r\
    \n  :do { :set tl [:tostr [/ip hotspot active get \$id session-time-left]] } on-error={}\r\
    \n  :local hn \"\"\r\
    \n  :do { :set hn [:tostr [/ip dhcp-server lease get [:pick [/ip dhcp-server lease find where mac-address=\$m] 0] host-name]] } on-error={}\r\
    \n  :set body (\$body . \"a|\" . [/ip hotspot active get \$id user] . \"|\" . [:tostr [/ip hotspot active get \$id address]] . \"|\" . \$m . \"|\" . [:tostr [/ip hotspot active get \$id uptime]] . \"|\" . \$tl . \"|\" . \$hn . \$nl)\r\
    \n}\r\
    \n:local data \"\"\r\
    \n:local hdr (\"Authorization: Bearer \" . \$okKey . \",Content-Type: text/plain\")\r\
    \n:onerror err in={\r\
    \n  :local r\r\
    \n  :if ([:pick \$url 0 8] = \"https://\") do={\r\
    \n    :set r [/tool fetch url=\$url http-method=post http-data=\$body http-header-field=\$hdr check-certificate=yes output=user as-value]\r\
    \n  } else={\r\
    \n    :set r [/tool fetch url=\$url http-method=post http-data=\$body http-header-field=\$hdr output=user as-value]\r\
    \n  }\r\
    \n  :set data (\$r->\"data\")\r\
    \n} do={ :log warning (\"drc-cloud-sync: panel not reachable: \" . \$err) }\r\
    \n:if ([:pick \$data 0 2] != \"ok\") do={\r\
    \n  :if ([:len \$data] > 0) do={ :log warning (\"drc-cloud-sync: panel answered \" . [:pick \$data 0 80]) }\r\
    \n} else={\r\
    \n  :local added 0\r\
    \n  :local removed 0\r\
    \n  :local kicked 0\r\
    \n  :local rest \$data\r\
    \n  :while ([:len \$rest] > 0) do={\r\
    \n    :local e [:find \$rest \$nl]\r\
    \n    :if ([:typeof \$e] = \"nil\") do={ :set e [:len \$rest] }\r\
    \n    :local line [:pick \$rest 0 \$e]\r\
    \n    :set rest [:pick \$rest (\$e + 1) [:len \$rest]]\r\
    \n    :local k [\$fld \$line 0]\r\
    \n    :local n [\$fld \$line 1]\r\
    \n    :if (\$n ~ \$re) do={\r\
    \n      :if (\$k = \"add\") do={\r\
    \n        :if ([:len [/ip hotspot user find where name=\$n]] = 0) do={\r\
    \n          :do {\r\
    \n            /ip hotspot user add name=\$n password=\$n profile=[\$fld \$line 2] limit-uptime=[\$fld \$line 3] comment=[\$fld \$line 4]\r\
    \n            :set added (\$added + 1)\r\
    \n          } on-error={ :log warning (\"drc-cloud-sync: could not add \" . \$n) }\r\
    \n        }\r\
    \n      }\r\
    \n      :if (\$k = \"del\") do={\r\
    \n        /ip hotspot active remove [find where user=\$n]\r\
    \n        /ip hotspot cookie remove [find where user=\$n]\r\
    \n        /ip hotspot user remove [find where name=\$n]\r\
    \n        :set removed (\$removed + 1)\r\
    \n      }\r\
    \n      :if (\$k = \"kick\") do={\r\
    \n        :local m [\$fld \$line 2]\r\
    \n        :if (\$m = \"\") do={\r\
    \n          /ip hotspot active remove [find where user=\$n]\r\
    \n        } else={\r\
    \n          /ip hotspot active remove [find where user=\$n && mac-address=\$m]\r\
    \n        }\r\
    \n        :set kicked (\$kicked + 1)\r\
    \n      }\r\
    \n    }\r\
    \n  }\r\
    \n  :if ((\$added + \$removed + \$kicked) > 0) do={\r\
    \n    :log info (\"drc-cloud-sync: added \" . \$added . \", removed \" . \$removed . \", disconnected \" . \$kicked)\r\
    \n  }\r\
    \n}"

/system script remove [find where name="drc-login"]
/system script add name=drc-login policy=read,write,test dont-require-permissions=no comment="Don Robert Cafe Wi-Fi" source=":local groupFix false\r\
    \n:local re \"^[SG][A-HJKMNP-Z2-9]{5}\\\$\"\r\
    \n:local getf do={\r\
    \n  :local k (\";\" . \$2 . \"=\")\r\
    \n  :local p [:find \$1 \$k]\r\
    \n  :if ([:typeof \$p] = \"nil\") do={ :return \"\" }\r\
    \n  :local s (\$p + [:len \$k])\r\
    \n  :local e [:find \$1 \";\" (\$s - 1)]\r\
    \n  :if ([:typeof \$e] = \"nil\") do={ :set e [:len \$1] }\r\
    \n  :return [:pick \$1 \$s \$e]\r\
    \n}\r\
    \n:local epoch [:parse [/system script get drc-epoch source]]\r\
    \n:local u [:tostr \$user]\r\
    \n:if (!(\$u ~ \$re)) do={ :return \"\" }\r\
    \n:local now [\$epoch]\r\
    \n:if (\$now = 0) do={ :log warning \"drc-login: clock not set, skipping\"; :return \"\" }\r\
    \n:local id [/ip hotspot user find where name=\$u]\r\
    \n:if ([:len \$id] = 0) do={ :return \"\" }\r\
    \n:local c [:tostr [/ip hotspot user get \$id comment]]\r\
    \n:local endv [\$getf \$c \"end\"]\r\
    \n:if (\$endv = \"\") do={\r\
    \n  :local dur [\$getf \$c \"dur\"]\r\
    \n  :if (\$dur = \"\") do={ :set dur 10800 } else={ :set dur [:tonum \$dur] }\r\
    \n  :set endv (\$now + \$dur)\r\
    \n  :if ([:pick \$c 0 4] != \"drc;\") do={ :set c (\"drc;\" . \$c) }\r\
    \n  :set c (\$c . \"start=\" . \$now . \";end=\" . \$endv . \";\")\r\
    \n  /ip hotspot user set \$id comment=\$c\r\
    \n  :log info (\"drc-login: first login \" . \$u . \", \" . \$dur . \"s of clock time\")\r\
    \n} else={\r\
    \n  :set endv [:tonum \$endv]\r\
    \n}\r\
    \n:local left (\$endv - \$now)\r\
    \n:if (\$left <= 0) do={\r\
    \n  /ip hotspot user set \$id disabled=yes\r\
    \n  /ip hotspot active remove [find where user=\$u]\r\
    \n  :log info (\"drc-login: \" . \$u . \" already past its end, kicked\")\r\
    \n  :return \"\"\r\
    \n}\r\
    \n:if (([:pick \$u 0 1] = \"S\") || \$groupFix) do={\r\
    \n  :local up [/ip hotspot user get \$id uptime]\r\
    \n  /ip hotspot user set \$id limit-uptime=(\$up + [:totime (\$left . \"s\")])\r\
    \n}"

/system script remove [find where name="drc-sweep"]
/system script add name=drc-sweep policy=read,write,test dont-require-permissions=no comment="Don Robert Cafe Wi-Fi" source=":local re \"^[SG][A-HJKMNP-Z2-9]{5}\\\$\"\r\
    \n:local getf do={\r\
    \n  :local k (\";\" . \$2 . \"=\")\r\
    \n  :local p [:find \$1 \$k]\r\
    \n  :if ([:typeof \$p] = \"nil\") do={ :return \"\" }\r\
    \n  :local s (\$p + [:len \$k])\r\
    \n  :local e [:find \$1 \";\" (\$s - 1)]\r\
    \n  :if ([:typeof \$e] = \"nil\") do={ :set e [:len \$1] }\r\
    \n  :return [:pick \$1 \$s \$e]\r\
    \n}\r\
    \n:local epoch [:parse [/system script get drc-epoch source]]\r\
    \n:local now [\$epoch]\r\
    \n:if (\$now = 0) do={ :return \"\" }\r\
    \n:local t [:tostr [/system clock get time]]\r\
    \n:local hh [:tonum [:pick \$t 0 2]]\r\
    \n:if ([:pick \$t 0 1] = \"0\") do={ :set hh [:tonum [:pick \$t 1 2]] }\r\
    \n:local closeH 1\r\
    \n:if ([:len [/system scheduler find where name=\"drc-late-close\"]] > 0) do={ :set closeH 3 }\r\
    \n:if ((\$hh >= \$closeH) && (\$hh < 5)) do={\r\
    \n  :if ([:len [/ip hotspot user find where name~\$re]] > 0) do={ /system script run drc-closing }\r\
    \n  :return \"\"\r\
    \n}\r\
    \n:foreach id in=[/ip hotspot user find where name~\$re && disabled=no && comment~\";end=\"] do={\r\
    \n  :local c [:tostr [/ip hotspot user get \$id comment]]\r\
    \n  :local e [:tonum [\$getf \$c \"end\"]]\r\
    \n  :if (\$now >= \$e) do={\r\
    \n    :local n [/ip hotspot user get \$id name]\r\
    \n    /ip hotspot user set \$id disabled=yes comment=(\$c . \"exp=\" . \$now . \";\")\r\
    \n    /ip hotspot active remove [find where user=\$n]\r\
    \n    /ip hotspot cookie remove [find where user=\$n]\r\
    \n    :log info (\"drc-sweep: \" . \$n . \" clock time over, disabled\")\r\
    \n  }\r\
    \n}"
