# Local development: copy to .env. On Vercel, set these in the project settings
# (see DEPLOY.md). Never commit .env.

# mock = built-in fake router (development), router = the real MikroTik checks in
ROUTER_MODE=mock
# Shared secret the router sends (32+ random characters). Required for ROUTER_MODE=router.
ROUTER_TOKEN=

# Database. Local file by default; on Vercel the Turso integration sets
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN instead.
DATABASE_URL=file:./data/panel.db
DATABASE_AUTH_TOKEN=

# Local server only (npm run dev / start). Use 0.0.0.0 only if the router must
# reach this PC for testing; otherwise keep 127.0.0.1.
PANEL_HOST=127.0.0.1
PANEL_PORT=8080

# Hotspot user profiles created in Phase 1
SOLO_PROFILE=solo-3h
GROUP_PROFILE=group-3h

# Printed on slips / used in the QR login link
WIFI_NAME=Don Robert Cafe - Free WiFi
QR_LOGIN_URL=http://192.168.88.1/login

# Mock router only: pretend customers log in with unused codes (1 = on)
MOCK_SIMULATE=1
